{"path": "docs/self-harden-lessons.md", "sections": [{"level": 1, "title": "self-harden 树 · 经验沉淀（踩了什么 / 怎么发现的 / 下次怎么避免）", "start": 1, "end": 126}, {"level": 2, "title": "1 本轮**宿主自己**犯的调用与判据错误（按要求单列）", "start": 16, "end": 36}, {"level": 2, "title": "2 三类「声明 vs 现实」裂缝（本轮反复出现的模式）", "start": 37, "end": 76}, {"level": 3, "title": "2.1 同一批产物**互相把对方写旧**（本轮至少 3 例）", "start": 39, "end": 51}, {"level": 3, "title": "2.2 提问通道：契约写的是 A，worker 实际走的是 B", "start": 52, "end": 65}, {"level": 3, "title": "2.3 承诺 vs 覆盖：注释说「同样要防漂移」，代码没接上", "start": 66, "end": 76}, {"level": 2, "title": "3 效率：代价读数 ↔ 四条纪律", "start": 77, "end": 93}, {"level": 2, "title": "4 未验证 / 未做到（**单列**，不许混进上面当成果）", "start": 94, "end": 108}, {"level": 2, "title": "5 待定项（本轮**只记不实现**）", "start": 109, "end": 121}, {"level": 2, "title": "6 一句话", "start": 122, "end": 126}]}
