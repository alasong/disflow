{
  "version": 1,
  "_doc": "手写事实源。字段与派生规则见 assets/README.md。tier=verified 必给 evidence。",
  "assets": {
    "agents": {
      "type": "doc",
      "category": "documentation",
      "path": "AGENTS.md",
      "purpose": "AI 常驻入口：动手/回答前先读 docs/INDEX.md + assets/INDEX.md（缺口修复见 ADR 0004）",
      "tier": "asserted",
      "premises": [
        "design",
        "pkg"
      ]
    },
    "requirements": {
      "type": "doc",
      "category": "requirement",
      "path": "docs/requirements.md",
      "purpose": "FR/NFR 需求基线（FR-1..29 + NFR-1..7），一切验收的源头",
      "tier": "asserted",
      "premises": []
    },
    "design": {
      "type": "doc",
      "category": "design",
      "path": "docs/design.md",
      "purpose": "实现契约：节点字段 / 事件 / 门 / 投影语义（改实现前先看它）",
      "tier": "asserted",
      "premises": [
        "requirements",
        "pkg"
      ]
    },
    "architecture": {
      "type": "doc",
      "category": "design",
      "path": "docs/architecture.md",
      "purpose": "按实现画的架构图（events→state→树/图/看板/分发/自检）",
      "tier": "asserted",
      "premises": [
        "pkg",
        "design"
      ]
    },
    "backlog": {
      "type": "doc",
      "category": "requirement",
      "path": "docs/v0.2-backlog.md",
      "purpose": "v0.2 未完成缺口清单（唯一放行依据）",
      "tier": "asserted",
      "premises": []
    },
    "board-entity": {
      "type": "doc",
      "category": "process",
      "path": "docs/decisions/0005-看板提升为一等实体.md",
      "purpose": "交付单元 Spec：看板升为一等实体（需求→设计→实现→验证→文档 全量交付）",
      "tier": "asserted",
      "premises": [
        "requirements",
        "pkg"
      ],
      "spec": {
        "required_roles": [
          "requirement",
          "design",
          "implementation",
          "verification",
          "documentation"
        ],
        "delivers": [
          "requirements",
          "design",
          "pkg",
          "tests",
          "readme"
        ]
      }
    },
    "fr-gap": {
      "type": "report",
      "category": "requirement",
      "path": "docs/fr-nfr-gap-report.md",
      "purpose": "需求覆盖机检报告（由 scripts/fr_check.py 生成）",
      "tier": "asserted",
      "premises": [
        "pkg",
        {
          "id": "scripts",
          "kind": "generated_from"
        }
      ]
    },
    "design-draft": {
      "type": "doc",
      "category": "design",
      "path": "docs/design-dispatch-tree-graph.md",
      "purpose": "分发器/树/图设计草稿（标注未实现）",
      "tier": "stub",
      "premises": []
    },
    "readme": {
      "type": "doc",
      "category": "documentation",
      "path": "README.md",
      "purpose": "5 分钟上手 walkthrough + 量化 / worktree 说明",
      "tier": "asserted",
      "premises": [
        "pkg"
      ]
    },
    "pkg": {
      "type": "code",
      "category": "implementation",
      "path": "disflow/",
      "purpose": "引擎包：状态/树/图/门/视图/CLI（唯一实现面）",
      "tier": "verified",
      "evidence": "python3 -m unittest discover -s tests -t tests",
      "premises": []
    },
    "tests": {
      "type": "test",
      "category": "verification",
      "path": "tests/",
      "purpose": "验收测试套件：门拒收 / 投影一致 / 分层自检 / CLI 回归",
      "tier": "verified",
      "evidence": "python3 -m unittest discover -s tests -t tests",
      "premises": [
        "requirements",
        "pkg"
      ]
    },
    "scripts": {
      "type": "script",
      "category": "implementation",
      "path": "scripts/",
      "purpose": "自检 / 探针 / 报告脚本（fr_check、mutation_check、assets_scan 等）",
      "tier": "asserted",
      "premises": [
        "pkg"
      ]
    },
    "config": {
      "type": "config",
      "category": "config",
      "path": "pyrightconfig.json",
      "purpose": "类型检查范围与 Python 版本",
      "tier": "asserted",
      "premises": []
    },
    "lens-config": {
      "type": "config",
      "category": "config",
      "path": ".pi-lens.json",
      "purpose": "pi-lens 静态检查规则开关",
      "tier": "asserted",
      "premises": []
    }
  }
}
